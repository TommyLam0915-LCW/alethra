# Python
__pycache__/
*.py[cod]
*.egg-info/
venv/
.venv/

# Node
node_modules/
.next/
out/

# Environment
.env
.env.local
.env.*.local
# Test-lane settings. Copy backend/.env.test.example to backend/.env.test and
# fill it in; the file itself stays local. This rule is inert while the path is
# still tracked — backend/tests/test_env_hygiene_contract.py reports which
# state the file is actually in, so "ignored" can never be claimed from this
# line alone.
.env.test

# Databases
*.db
*.sqlite3
# Local DB snapshots (never commit real data backups)
*.db.backup-*

# Build / runtime artifacts
*.tsbuildinfo
backend/uvicorn*.log

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Test artifacts
.pytest_cache/
htmlcov/
.coverage
frontend/playwright-report/
frontend/test-results/

# Exports output
exports_output/

# ML model artifacts (binary files, not for version control)
backend/app/ml/artifacts/
*.joblib

# Deployment backups
backups/

# Local-only runtime state (generated credentials, stack logs, browser evidence)
.local/

# Playwright / pytest artifacts anywhere in the tree
test-results/
playwright-report/
