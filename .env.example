# ──────────────────────────────────────────────────────────────
# Alethra -- Environment Variables
# ──────────────────────────────────────────────────────────────
# Copy to .env and fill in real values. NEVER commit .env.
# Generate secrets with:  openssl rand -hex 32
# ──────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=alethra
POSTGRES_PASSWORD=                    # REQUIRED -- generate: openssl rand -hex 32
POSTGRES_DB=alethra

# ── Redis ─────────────────────────────────────────────────────
REDIS_PASSWORD=                       # REQUIRED -- generate: openssl rand -hex 32

# ── Backend / JWT ────────────────────────────────────────────
JWT_SECRET_KEY=                       # REQUIRED -- generate: openssl rand -hex 32  (min 32 chars)
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── AI Provider ───────────────────────────────────────────────
AI_PROVIDER=mock                      # mock | openai | anthropic
AI_MODEL=mock-model                   # e.g. gpt-4o, claude-sonnet-4-20250514
AI_API_KEY=                           # required when AI_PROVIDER != mock

# ── Data Provider ─────────────────────────────────────────────
DATA_PROVIDER=demo                    # demo | lseg

# ── Application ───────────────────────────────────────────────
APP_ENV=production                    # development | staging | production
CORS_ORIGINS=https://your-domain.com  # comma-separated; no wildcards in prod

# ── Feature Flags ─────────────────────────────────────────────
ENABLE_LIVE_PAYMENTS=false
ENABLE_PUBLIC_SHARING=false
ENABLE_EXTERNAL_NOTIFICATIONS=false

# ── Stripe (only when ENABLE_LIVE_PAYMENTS=true) ─────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Frontend ──────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-domain.com/api
