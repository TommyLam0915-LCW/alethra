# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai_investment_lab

# JWT Authentication
JWT_SECRET_KEY=change-me-in-production-use-a-long-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Provider (Phase 2 - not used in Phase 1)
AI_PROVIDER=mock
AI_MODEL=mock-model
AI_API_KEY=not-used-in-phase-1

# Data Provider
DATA_PROVIDER=demo

# Application
APP_ENV=development
ENABLE_LIVE_PAYMENTS=false
ENABLE_PUBLIC_SHARING=false
ENABLE_EXTERNAL_NOTIFICATIONS=false

# CORS
CORS_ORIGINS=http://localhost:3000
