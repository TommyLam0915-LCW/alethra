# Test Environment Configuration
# ISOLATED FROM PRODUCTION — DO NOT USE FOR LIVE TRADING

# Test database (disposable)
# Password injected via ALETHRA_TEST_RUNTIME_PASSWORD environment variable
# Do NOT write actual passwords in version control
DATABASE_URL=postgresql://alethra_test_runtime:${ALETHRA_TEST_RUNTIME_PASSWORD}@localhost:5432/ai_investment_lab_test

# SAFETY: All trading features DISABLED
LIVE_TRADING_ENABLED=false
RESEARCH_AUTH_BYPASS_ENABLED=false
ENABLE_LEARNING_SCHEDULER=false
AUTO_COLLECTION_ENABLED=false

# Test data provider (synthetic, not real market data)
DATA_PROVIDER=synthetic_stock

# Test mode flag (applications can check this)
TEST_MODE=true
TEST_ENVIRONMENT=true

# Disable external connections
KRAKEN_WS_URL=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Test-specific settings
TEST_USER_EMAIL=test@alethra-local.example.com
TEST_ADMIN_EMAIL=admin@alethra-local.example.com
