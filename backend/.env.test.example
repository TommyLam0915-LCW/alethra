# Test Environment Configuration — TEMPLATE
# ISOLATED FROM PRODUCTION — DO NOT USE FOR LIVE TRADING
#
# Copy this file to backend/.env.test and fill in the local values. The copy is
# ignored by git; this template is the tracked half.
#
# Nothing in the repository reads either file: no app module, no test and no
# script sources backend/.env.test. The backend reads real environment
# variables, and scripts/run_tests.sh is what sets them. Treat this as the
# documented shape of a test lane, not as a switch you can flip by editing it.
#
# Rule for every secret-shaped key (PASSWORD / SECRET / API_KEY / TOKEN):
# either empty, or an injection that fails closed when the value is missing.
# `${VAR:?message}` refuses to source instead of defaulting to a guess, so an
# unset password is an error at the top of the run rather than a connection to
# the wrong database later. backend/scripts/check_env_hygiene.py enforces it
# and backend/tests/test_env_hygiene_contract.py pins the enforcement.
# Do NOT write actual passwords in version control.

# Test database (disposable; the role and the name are the local lane's own)
# Password injected via ALETHRA_TEST_RUNTIME_PASSWORD environment variable
DATABASE_URL=postgresql://alethra_test_runtime:${ALETHRA_TEST_RUNTIME_PASSWORD:?set ALETHRA_TEST_RUNTIME_PASSWORD before sourcing}@localhost:5432/ai_investment_lab_test

# SAFETY: All trading features DISABLED
LIVE_TRADING_ENABLED=false
RESEARCH_AUTH_BYPASS_ENABLED=false
ENABLE_LEARNING_SCHEDULER=false
AUTO_COLLECTION_ENABLED=false

# Test data provider (synthetic, not real market data)
DATA_PROVIDER=synthetic_stock

# Test mode flag (applications can check this)
TEST_MODE=true
TEST_ENVIRONMENT=true

# Disable external connections — empty means "no key, no socket"
KRAKEN_WS_URL=
KRAKEN_API_KEY=
KRAKEN_API_SECRET=

# Test-specific settings (local identities created by the test lane)
TEST_USER_EMAIL=test-user@example.invalid
TEST_ADMIN_EMAIL=test-admin@example.invalid
